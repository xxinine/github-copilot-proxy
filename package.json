{
  "name": "copilot-proxy-multitenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "control-plane"
  ],
  "scripts": {
    "dev:cp": "CPX_DB_PATH=\"$PWD/data/cpx.db\" npm -w control-plane run dev",
    "dev:proxy": "CPX_DB_PATH=\"$PWD/data/cpx.db\" bash -c 'cd proxy && bun run src/cpx/main.ts'",
    "build": "npm -w control-plane run build"
  },
  "engines": {
    "node": ">=20"
  }
}
